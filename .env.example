# ==========================================
# LibraryHub Environment Configuration
# ==========================================

# Django Secret Key (Generate a random string for production)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated hostnames or domains)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database URL
# In local development, leave this empty to use SQLite (db.sqlite3).
# In production (Render PostgreSQL), provide your connection string:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# CSRF Trusted Origins (Comma-separated URLs with scheme, required for HTTPS on Render)
# CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com

# SSL Redirect (Set to True in production with HTTPS)
# SECURE_SSL_REDIRECT=True
